{
    "id": "cursor.com",
    "name": "Cursor",
    "description": "Extract billing information from Cursor dashboard",
    "homepage": "https://cursor.com",
    "getDocuments": [
        {
            "action": "navigate",
            "url": "https://cursor.com/dashboard?tab=billing"
        },
        {
            "action": "waitForElement",
            "selector": "button",
            "textContent": "Manage subscription",
            "timeout": 10000
        },
        {
            "action": "click",
            "selector": "button",
            "textContent": "Manage subscription",
            "expectNewTab": true
        },
        {
            "action": "executeRecipe",
            "recipeId": "stripe-dashboard"
        }
    ]
}

