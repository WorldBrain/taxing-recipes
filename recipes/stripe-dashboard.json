{
    "id": "stripe-dashboard",
    "name": "Stripe Billing Portal",
    "description": "Generic Stripe billing portal for downloading invoices",
    "checkAuth": [],
    "startAuth": [],
    "inputVariables": [
        "lastFetchTimestamp"
    ],
    "getDocuments": [
        {
            "action": "paginate",
            "selector": "[data-testid=\"view-more-button\"]"
        },
        {
            "action": "extractAll",
            "selector": "a[href^='https://invoice.stripe.com/i/']",
            "fields": {
                "date": {
                    "selector": "div:first-child > div:first-child"
                },
                "status": {
                    "selector": "div:first-child > div:nth-child(3)"
                },
                "pdfLink": {
                    "extract": {
                        "attribute": "href"
                    }
                },
                "id": {
                    "selector": ".",
                    "extract": {
                        "attribute": "href"
                    }
                }
            },
            "forEach": [
               {
    "action": "if",
    "conditions": [
        {
            "left": "{{item.status}}",
            "operator": "==",
            "right": "Paid"
        },
        {
            "left": "{{item.date}}",
            "operator": ">",
            "right": "{{lastFetchTimestamp}}"
        }
    ],
    "logic": "and",
    "then": [
        {
            "action": "openNewTab",
            "url": "{{item.pdfLink}}"
        },
        {
            "action": "waitForElement",
            "selector": "button",
            "textContent": "Download invoice",
            "timeout": 15000
        },
        {
            "action": "click",
            "selector": "button",
            "textContent": "Download invoice",
            "interceptDownload": true
        }
    ],
    "else": []  // Optional: steps if conditions fail
}
            ]
        }
    ]
}
